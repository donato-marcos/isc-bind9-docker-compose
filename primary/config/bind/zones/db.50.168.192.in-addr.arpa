$TTL 86400
@       IN      SOA     ns1.fatec.lab. admin.fatec.lab. (
                        2026070901  ; Serial
                        3600        ; Refresh
                        1800        ; Retry
                        604800      ; Expire
                        86400 )     ; Minimum TTL

; Name Servers
@       IN      NS      ns1.fatec.lab.
@       IN      NS      ns2.fatec.lab.

; A Records for Name Servers
ns1     IN      A       172.20.0.10  ; IP Exemplo do Primário
ns2     IN      A       172.20.0.11 ; IP Exemplo do Secundário

; PTR Records
10      IN      PTR     ns1.fatec.lab.
11      IN      PTR     ns2.fatec.lab.
100     IN      PTR     www.fatec.lab.
101     IN      PTR     mail.fatec.lab.
